{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=LibraryManagementDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "SecretKey": "dev-only-secret-key-change-me-at-least-32-characters-long",
    "Issuer": "LibraryManagementSystem",
    "Audience": "LibraryManagementSystem",
    "AccessTokenExpiryMinutes": "60"
  },
  "FileStorage": {
    "BasePath": "uploads",
    "BaseUrl": "https://localhost:7001/uploads",
    "MaxFileSizeMB": 10
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "FromEmail": "noreply@library.local",
    "FromName": "Library Management System",
    "EnableSsl": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/lms-.log", "rollingInterval": "Day" } }
    ]
  },
  "AllowedHosts": "*"
}
