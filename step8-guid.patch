diff --git a/src/LMS.Domain/Entities/BaseEntity.cs b/src/LMS.Domain/Entities/BaseEntity.cs
index 9eccdde..3893b37 100644
--- a/src/LMS.Domain/Entities/BaseEntity.cs
+++ b/src/LMS.Domain/Entities/BaseEntity.cs
@@ -2,7 +2,7 @@ namespace LMS.Domain.Entities;
 
 public abstract class BaseEntity
 {
-    public Guid Id { get; set; }
+    public Guid Id { get; set; } = Guid.NewGuid();
     public DateTime CreatedAt { get; set; } = DateTime.UtcNow;
     public DateTime? UpdatedAt { get; set; }
     public bool IsDeleted { get; set; } = false;
diff --git a/src/LMS.Infrastructure/Data/LibraryDbContext.cs b/src/LMS.Infrastructure/Data/LibraryDbContext.cs
index ab7101a..e8e866c 100644
--- a/src/LMS.Infrastructure/Data/LibraryDbContext.cs
+++ b/src/LMS.Infrastructure/Data/LibraryDbContext.cs
@@ -62,6 +62,15 @@ public class LibraryDbContext : DbContext
         modelBuilder.ApplyConfiguration(new SettingConfiguration());
         modelBuilder.ApplyConfiguration(new AuditLogConfiguration());
 
+        // IDs are generated in code (BaseEntity.Id = Guid.NewGuid()). Telling EF the key is NOT
+        // database-generated makes new entities added via navigations (e.g. user.RefreshTokens.Add)
+        // be inserted (Added) instead of being treated as existing rows (Modified -> concurrency error).
+        foreach (var entityType in modelBuilder.Model.GetEntityTypes()
+                     .Where(t => typeof(BaseEntity).IsAssignableFrom(t.ClrType)))
+        {
+            modelBuilder.Entity(entityType.ClrType).Property(nameof(BaseEntity.Id)).ValueGeneratedNever();
+        }
+
         // Global query filters for soft delete
         modelBuilder.Entity<User>().HasQueryFilter(u => !u.IsDeleted);
         modelBuilder.Entity<Member>().HasQueryFilter(m => !m.IsDeleted);
